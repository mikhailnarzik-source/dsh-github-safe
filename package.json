{
  "name": "dsh-github-safe",
  "version": "1.0.0",
  "description": "GitHub tools for DeepSeek Harness behind a deny-by-default allowlist: repository content only, no account, profile, organisation or access management, no DELETE.",
  "type": "module",
  "license": "MIT",
  "author": "mikhailnarzik-source",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikhailnarzik-source/dsh-github-safe.git"
  },
  "homepage": "https://github.com/mikhailnarzik-source/dsh-github-safe#readme",
  "bugs": {
    "url": "https://github.com/mikhailnarzik-source/dsh-github-safe/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
